# =============================================================================================
# UserService — variables de entorno
#
# Copia este archivo a .env y ajusta los valores. Las variables marcadas como obligatorias no
# tienen valor por defecto en application.yaml.
# =============================================================================================

# === Base de datos (obligatorias) ===
DB_URL=jdbc:postgresql://localhost:5432/fatum_users
DB_USERNAME=postgres
DB_PASSWORD=postgres

# === Cognito (obligatorias) ===
USER_POOL_ID=us-east-1_9qUKvpTsS
# Secreto que la Lambda envía en la cabecera Lambda-Secret al llamar a /users/register.
LAMBDA_SECRET=change-me

# === EventBridge ===
BUS_NAME = mi-bus-de-eventos
EVENT_ENDPOINT = http://localhost:4566

#===== SQS =====
QUEUE_URL = http://localhost:4566/000000000000/fatum-event-queue


# === Servicio de archivos compartido ===
# Este servicio ya no habla con S3: elige una ruta y el servicio de archivos decide el bucket.
FILE_SERVICE_URL=http://localhost:8081
# Debe coincidir con STORAGE_INTERNAL_SECRET del servicio de archivos. Vacío desactiva la cabecera.
FILE_SERVICE_SECRET=

# === Grupos de Cognito ===
COGNITO_GROUPS_ENABLED=true
COGNITO_VERIFIED_GROUP=VERIFIED
COGNITO_PROFESSIONAL_GROUP=PROFESSIONAL
COGNITO_USE_SUB_AS_USERNAME=false
# true hace fallar el registro si Cognito no responde.
COGNITO_STRICT=false

# === Opcionales (tienen valor por defecto) ===
# AWS_REGION=us-east-1
# PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# FLYWAY_ENABLED=true
# MAX_FILE_SIZE=10MB
# MAX_REQUEST_SIZE=10MB
# FILE_SERVICE_CONNECT_TIMEOUT=2s
# FILE_SERVICE_READ_TIMEOUT=20s
# FILE_SERVICE_PROFILE_IMAGE_ROUTE=user-service:profile-image
# FILE_SERVICE_DOCUMENT_ROUTE=user-service:document
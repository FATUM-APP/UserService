# =============================================================================================
# UserService — variables de entorno
# =============================================================================================

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/fatum_users
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Cognito / AWS ---
USER_POOL_ID=us-east-1_9qUKvpTsS
AWS_REGION=us-east-1
LAMBDA_SECRET=#BrandNewDay2026

# --- Servicio de archivos compartido (ya no se habla con S3 directamente) ---
FILE_SERVICE_URL=http://localhost:8081
FILE_SERVICE_SECRET=cambia-este-secreto
FILE_SERVICE_PROFILE_IMAGE_ROUTE=user-service:profile-image
FILE_SERVICE_LIVENESS_ROUTE=user-service:liveness
FILE_SERVICE_DOCUMENT_ROUTE=user-service:document

# --- Verificación de identidad ---
VERIFICATION_ENABLED=true
VERIFICATION_MAX_ATTEMPTS=3
VERIFICATION_VERIFIED_THRESHOLD=80
VERIFICATION_MANUAL_THRESHOLD=30
VERIFICATION_HARD_REJECT_THRESHOLD=20
VERIFICATION_FRAUD_RISK_THRESHOLD=70
VERIFICATION_MIN_FACE_MATCH=20
VERIFICATION_PROFILE_PHOTO_THRESHOLD=80
# Cambios de foto de perfil encolados por día (límite de coste de Rekognition).
VERIFICATION_MAX_PHOTO_CHANGES=5
VERIFICATION_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Prueba de vida (Rekognition Face Liveness) ---
# Es el único paso que cuesta dinero en cada intento: solo se pide cuando la fase gratuita pasó el 80 %.
# El bucket lo lee el comparador de rostros directamente, por eso va en su propia variable.
S3_LIVENESS_BUCKET=fatum-liveness
VERIFICATION_LIVENESS_ENABLED=true
VERIFICATION_LIVENESS_PREFIX=liveness
VERIFICATION_LIVENESS_MIN_CONFIDENCE=80
# Sesiones por intento: un tope por si el cliente abre varias sin llegar a terminar ninguna.
VERIFICATION_LIVENESS_MAX_SESSIONS=3

# --- Grupos de Cognito ---
COGNITO_GROUPS_ENABLED=true
COGNITO_VERIFIED_GROUP=VERIFIED
COGNITO_PROFESSIONAL_GROUP=PROFESSIONAL
# COGNITO_STRICT=false

# === Opcionales (tienen valor por defecto) ===
# PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# FLYWAY_ENABLED=true
# MAX_FILE_SIZE=15MB
# MAX_REQUEST_SIZE=30MB
# FILE_SERVICE_CONNECT_TIMEOUT=2s
# FILE_SERVICE_READ_TIMEOUT=20s
# VERIFICATION_WEIGHT_DOCUMENT=0.35
# VERIFICATION_WEIGHT_DOCUMENT_PROFILE=0.30
# VERIFICATION_WEIGHT_REFERENCE_DOCUMENT=0.20
# VERIFICATION_WEIGHT_AUTHENTICITY=0.15
# VERIFICATION_LIVENESS_AUDIT_IMAGES=0
# VERIFICATION_LIVENESS_SESSION_TTL=3m
# VERIFICATION_TEXTRACT_ENABLED=true
# VERIFICATION_REKOGNITION_ENABLED=true
# VERIFICATION_BEDROCK_ENABLED=true
# VERIFICATION_BEDROCK_MAX_TOKENS=800
# VERIFICATION_BEDROCK_TEMPERATURE=0
# COGNITO_USE_SUB_AS_USERNAME=false
